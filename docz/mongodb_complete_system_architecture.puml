@startuml MongoDB 完整架构图

!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

title MongoDB 完整架构 - 源码实现分析

' 客户端层
package "客户端层" {
    [应用程序] as APP
    [MongoDB 驱动] as DRIVER
    [MongoDB Shell] as SHELL
    [MongoDB Compass] as COMPASS
}

' 路由层 (mongos)
package "路由层 - mongos" {
    component "网络层" {
        [Transport Layer] as MONGOS_TL
        [Service Entry Point] as MONGOS_SEP
    }

    component "路由核心" {
        [Query Router] as QR
        [Collection Routing Info Targeter] as CRIT
        [Shard Targeter] as ST
        [Cluster Commands Helpers] as CCH
    }

    component "执行引擎" {
        [Router Exec Stage] as RES
        [Cluster Client Cursor] as CCC
        [Pipeline Merger] as PM
    }

    component "缓存层" {
        [Routing Table Cache] as RTC
        [Shard Registry] as SR
        [Database Cache] as DC
    }
}

' 配置服务器集群
package "配置服务器集群" {
    component "Config Server Replica Set" {
        [Config Primary] as CP
        [Config Secondary 1] as CS1
        [Config Secondary 2] as CS2
    }

    component "元数据管理" {
        [ShardingCatalogManager] as SCM
        [ConfigServerOpObserver] as CSO
        [ShardingCatalogClient] as SCC
    }

    component "元数据存储" {
        database "config.shards" as SHARDS_DB
        database "config.collections" as COLLECTIONS_DB
        database "config.chunks" as CHUNKS_DB
        database "config.databases" as DATABASES_DB
        database "config.settings" as SETTINGS_DB
    }
}

' 分片集群
package "分片集群" {
    component "Shard 1 Replica Set" {
        [Shard1 Primary] as S1P
        [Shard1 Secondary 1] as S1S1
        [Shard1 Secondary 2] as S1S2
    }

    component "Shard 2 Replica Set" {
        [Shard2 Primary] as S2P
        [Shard2 Secondary 1] as S2S1
        [Shard2 Secondary 2] as S2S2
    }

    component "Shard N Replica Set" {
        [ShardN Primary] as SNP
        [ShardN Secondary 1] as SNS1
        [ShardN Secondary 2] as SNS2
    }
}

' mongod 内部架构
package "mongod 内部架构" {
    component "网络传输层" {
        [Transport Layer Manager] as TLM
        [Session Manager] as SM
        [Service Entry Point] as SEP
    }

    component "服务上下文层" {
        [Service Context] as SC
        [Service] as SVC
        [Client] as CLIENT
        [Operation Context] as OPCTX
    }

    component "命令处理层" {
        [Command Registry] as CR
        [Command Handlers] as CMD
        [Command Invocation] as CI
    }

    component "查询处理层" {
        [Query Parser] as QP
        [Query Planner] as QPL
        [Query Executor] as QE
        [Aggregation Framework] as AF
        [Plan Cache] as PC
    }

    component "存储引擎层" {
        [Storage Engine Interface] as SEI
        [Record Store] as RS
        [Index Manager] as IM
        [Transaction Manager] as TM
    }

    component "复制系统" {
        [Replication Coordinator] as RC
        [Oplog Manager] as OM
        [Election Manager] as EM
        [Sync Source] as SS
    }

    component "分片系统" {
        [Sharding State] as SHARD_STATE
        [Collection Sharding Runtime] as CSR
        [Migration Manager] as MM
        [Balancer] as BAL
    }
}

' WiredTiger 存储引擎
package "WiredTiger 存储引擎" {
    component "WiredTiger 适配层" {
        [WiredTigerKVEngine] as WTKE
        [WiredTigerRecordStore] as WTRS
        [WiredTigerIndex] as WTI
        [WiredTigerRecoveryUnit] as WTRU
        [WiredTigerConnection] as WTC
    }

    component "WiredTiger 核心层" {
        [Session Manager] as WT_SM
        [Transaction Manager] as WT_TM
        [Cache Manager] as WT_CM
        [Checkpoint Manager] as WT_CP
        [B-Tree Engine] as WT_BT
        [LSM Engine] as WT_LSM
    }

    component "物理存储" {
        database "Data Files (.wt)" as DF
        database "Index Files (.wt)" as IF
        database "Log Files" as LF
        database "Metadata Files" as MF
    }
}

' 性能优化特性
package "性能优化特性" {
    component "查询优化" {
        [Query Optimizer] as QO
        [Index Optimizer] as IO
        [Cost Estimator] as CE
    }

    component "执行优化" {
        [Classic Execution Engine] as CEE
        [Slot-Based Execution] as SBE
        [Vectorized Execution] as VE
        [JIT Compilation] as JIT
    }

    component "聚合优化" {
        [Pipeline Optimizer] as PO
        [Stage Optimizer] as SO
        [Group Optimizer] as GO
    }

    component "缓存优化" {
        [WiredTiger Cache] as WTC_CACHE
        [Query Cache] as QC
        [Index Cache] as IC
        [Metadata Cache] as MC
    }
}

' 连接关系
APP --> DRIVER
DRIVER --> MONGOS_TL
SHELL --> MONGOS_TL
COMPASS --> MONGOS_TL

MONGOS_TL --> MONGOS_SEP
MONGOS_SEP --> QR
QR --> CRIT
CRIT --> ST
ST --> CCH
CCH --> RES
RES --> CCC
CCC --> PM

QR --> RTC
CRIT --> SR
ST --> DC

RTC --> CP
SR --> CP
DC --> CP

CP --> CS1
CP --> CS2
CS1 --> CP
CS2 --> CP

SCM --> CSO
CSO --> SCC
SCM --> SHARDS_DB
SCM --> COLLECTIONS_DB
SCM --> CHUNKS_DB
SCM --> DATABASES_DB
SCM --> SETTINGS_DB

CCC --> S1P
CCC --> S2P
CCC --> SNP

S1P --> S1S1
S1P --> S1S2
S2P --> S2S1
S2P --> S2S2
SNP --> SNS1
SNP --> SNS2

' mongod 内部连接
TLM --> SM
SM --> SEP
SEP --> SC
SC --> SVC
SVC --> CLIENT
CLIENT --> OPCTX

OPCTX --> CR
CR --> CMD
CMD --> CI

CI --> QP
QP --> QPL
QPL --> QE
QE --> AF
QPL --> PC

QE --> SEI
SEI --> RS
SEI --> IM
SEI --> TM

OPCTX --> RC
RC --> OM
RC --> EM
RC --> SS

OPCTX --> SHARD_STATE
SHARD_STATE --> CSR
CSR --> MM
MM --> BAL

' WiredTiger 连接
SEI --> WTKE
RS --> WTRS
IM --> WTI
TM --> WTRU
WTKE --> WTC

WTC --> WT_SM
WTRU --> WT_TM
WTRS --> WT_CM
WTI --> WT_CP
WT_CM --> WT_BT
WT_CM --> WT_LSM

WT_BT --> DF
WT_BT --> IF
WT_TM --> LF
WT_CP --> MF

' 性能优化连接
QPL --> QO
QO --> IO
QO --> CE

QE --> CEE
QE --> SBE
SBE --> VE
SBE --> JIT

AF --> PO
PO --> SO
PO --> GO

WT_CM --> WTC_CACHE
PC --> QC
IM --> IC
SCM --> MC

note right of APP
  客户端应用通过驱动程序
  连接到 MongoDB 集群
end note

note right of QR
  mongos 路由器负责:
  - 查询路由
  - 结果合并
  - 负载均衡
  - 故障转移
end note

note right of SCM
  配置服务器管理:
  - 分片元数据
  - 块分布信息
  - 集合分片配置
  - 平衡器状态
end note

note right of WTKE
  WiredTiger 特性:
  - 文档级并发控制
  - MVCC 多版本控制
  - 数据压缩
  - 事务支持
  - 检查点恢复
end note

note right of QO
  性能优化包括:
  - 查询计划缓存
  - 索引选择优化
  - 聚合管道优化
  - 并行执行
  - 智能缓存
end note

@enduml
