@startuml MongoDB数据库架构师视角
title MongoDB 分布式数据库系统架构设计 - 架构师视角

!define LIGHT_BLUE #E8F4FD
!define LIGHT_GREEN #E8F5E8
!define LIGHT_ORANGE #FFF8E1
!define LIGHT_PURPLE #F3E5F5
!define LIGHT_GRAY #F8F9FA

' ================================
' 客户端接入与负载分发层
' ================================
package ClientAccessLayer as "客户端接入与负载分发层" LIGHT_GRAY {
    
    component ApplicationTier as "应用程序层" #FFFFFF {
        [Web应用服务器] as WebServers
        [微服务集群] as Microservices
        [数据分析平台] as Analytics
        [移动应用后端] as MobileBackend
        
        note right of WebServers
            **设计思路**: 
            - 多语言驱动支持
            - 连接池管理
            - 自动故障转移
            - 读写分离配置
        end note
    }
    
    component DriverLayer as "驱动程序层" #FFFFFF {
        [MongoDB Driver Pool] as DriverPool
        [Connection Manager] as ConnMgr
        [Load Balancer] as LoadBalancer
        [Failover Handler] as FailoverHandler
        
        WebServers --> DriverPool
        Microservices --> DriverPool
        Analytics --> DriverPool
        MobileBackend --> DriverPool
        
        DriverPool --> ConnMgr
        ConnMgr --> LoadBalancer
        LoadBalancer --> FailoverHandler
    }
}

' ================================
' mongos 查询路由与分发层
' ================================
package QueryRoutingLayer as "查询路由与分发层" LIGHT_BLUE {
    
    component MongosCluster as "mongos 路由器集群" #FFFFFF {
        [mongos Instance 1] as Mongos1
        [mongos Instance 2] as Mongos2
        [mongos Instance N] as MongosN
        
        note right of Mongos1
            **核心设计原则**:
            - 无状态架构设计
            - 水平扩展能力
            - 查询路由优化
            - 结果聚合处理
            
            **源码位置**:
            src/mongo/s/service_entry_point_router_role.cpp
            src/mongo/s/grid.cpp
        end note
    }
    
    component RoutingCore as "路由核心引擎" #FFFFFF {
        [ServiceEntryPointRouterRole] as RouterEntry
        [Grid] as GridManager
        [CollectionRoutingInfoTargeter] as Targeter
        [ShardRegistry] as ShardRegistry
        [CatalogCache] as CatalogCache
        [ClusterCursorManager] as CursorManager
        
        RouterEntry --> GridManager : 请求分发
        GridManager --> Targeter : 路由决策
        Targeter --> ShardRegistry : 分片查找
        ShardRegistry --> CatalogCache : 元数据缓存
        GridManager --> CursorManager : 游标管理
        
        note right of Targeter
            **路由策略**:
            - 分片键匹配路由
            - 范围查询分发
            - 广播查询处理
            - 聚合管道优化
        end note
    }
    
    component QueryProcessing as "查询处理引擎" #FFFFFF {
        [ClusterFind] as ClusterFind
        [ClusterAggregate] as ClusterAgg
        [ClusterWrite] as ClusterWrite
        [AsyncResultsMerger] as ResultMerger
        [ParallelQueryExecutor] as ParallelExec
        
        Targeter --> ClusterFind : 查找操作
        Targeter --> ClusterAgg : 聚合操作
        Targeter --> ClusterWrite : 写入操作
        ClusterFind --> ResultMerger : 结果合并
        ClusterAgg --> ResultMerger : 聚合结果
        ParallelExec --> ResultMerger : 并行执行
    }
}

